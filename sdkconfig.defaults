# Mi Air Purifier 3H/3C Matter firmware — classic ESP32 (ESP-WROOM-32D), Matter
# over Wi-Fi, BLE for commissioning only. Based on esp-matter's light example
# (examples/light/sdkconfig.defaults, the esp32 Wi-Fi reference) plus the
# conventions of esp32-homecontrol-matter.

CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Updates over Wi-Fi: a new image that isn't kept within two minutes is
# rolled back by the bootloader (main/ota_server.cpp).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# DHCP hostname, so routers that register them (e.g. a FRITZ!Box:
# mi-air-purifier.fritz.box) can resolve the update server.
CONFIG_LWIP_LOCAL_HOSTNAME="mi-air-purifier"
# Matter takes most of the default 10 sockets; leave room for the update server.
CONFIG_LWIP_MAX_SOCKETS=16

# The module is a single-core ESP32 (rev 1.0), confirmed on a 3H in Phase 0
# (dump/README.md).
CONFIG_FREERTOS_UNICORE=y

# The MAC eFuse checksum is invalid on Xiaomi's modules (confirmed on a 3H:
# stored 0x75, calculated 0x10); without this the MAC read fails at boot.
CONFIG_ESP_MAC_IGNORE_MAC_CRC_ERROR=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# BLE (NimBLE) for commissioning; esp-matter releases its memory afterwards.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Wi-Fi station only, no soft-AP.
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# WPA2 only: without WPA3 (SAE) support the station joins mixed WPA2/WPA3
# ("transition mode") networks with WPA2. With SAE enabled a 3H failed every
# key handshake on a FRITZ!Box 4040 in mixed mode (reason 17,
# IE_IN_4WAY_DIFFERS); with it off it connects at once. Pure WPA3 networks
# can't be joined.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n

# lwIP as in the esp-matter Wi-Fi examples.
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_MBEDTLS_HKDF_C=y

# Matter identity. Test vendor ID; product ID distinct from the plant monitor.
CONFIG_CHIP_PROJECT_CONFIG="main/chip_project_config.h"
CONFIG_DEVICE_VENDOR_ID=0xFFF2
CONFIG_DEVICE_PRODUCT_ID=0x8003
CONFIG_DEFAULT_DEVICE_HARDWARE_VERSION=1
# Air Purifier device type (0x002D), advertised during commissioning.
CONFIG_DEVICE_TYPE=45
CONFIG_ENABLE_COMMISSIONABLE_DEVICE_TYPE=y
CONFIG_USE_TEST_SERIAL_NUMBER="MIPURIFIER-0001"

# Root node + 4 endpoints in use; room for a couple more (append only).
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=6

CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_SUPPORT_CLOSURE_CONTROL_CLUSTER=n
CONFIG_SUPPORT_CLOSURE_DIMENSION_CLUSTER=n
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n

# Keep the console readable: CHIP SDK errors only.
CONFIG_LOG_COLORS=n
CONFIG_CHIP_LOG_DEFAULT_LEVEL_EQUALS_LOG_DEFAULT_LEVEL=n
CONFIG_CHIP_LOG_DEFAULT_LEVEL_ERROR=y
